{
 "doctype": "DocType",
 "name": "Customer App Contact",
 "module": "Zeloura",
 "autoname": "field:mobile",
 "engine": "InnoDB",
 "field_order": ["mobile", "app_installed", "app_platform", "app_last_seen", "invite_status", "invite_order", "invite_queued_at", "invite_sent_at", "invite_note"],
 "fields": [
  {"fieldname": "mobile", "fieldtype": "Data", "label": "Customer Mobile", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "app_installed", "fieldtype": "Check", "label": "App Installation Recorded", "default": "0", "in_list_view": 1},
  {"fieldname": "app_platform", "fieldtype": "Select", "label": "Installation Evidence", "options": "\nAndroid\niOS\nPWA\nStaff"},
  {"fieldname": "app_last_seen", "fieldtype": "Datetime", "label": "Installation Last Recorded"},
  {"fieldname": "invite_status", "fieldtype": "Select", "label": "Installation SMS", "options": "\nQueued\nSending\nSent\nFailed\nSkipped", "in_list_view": 1},
  {"fieldname": "invite_order", "fieldtype": "Link", "label": "Invitation Purchase", "options": "POS Order"},
  {"fieldname": "invite_queued_at", "fieldtype": "Datetime", "label": "Invitation Queued At"},
  {"fieldname": "invite_sent_at", "fieldtype": "Datetime", "label": "SMS Accepted At"},
  {"fieldname": "invite_note", "fieldtype": "Small Text", "label": "Invitation Result"}
 ],
 "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "report": 1}],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 0
}
