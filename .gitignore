.DS_Store
*.pyc
*.egg-info
*.swp
tags
node_modules
__pycache__

# Binaries (the print companion APK is built/served, not source)
*.apk

# Client-specific config. The keys and ids for a particular restaurant live in
# sites/<site>/site_config.json — outside this repo entirely, which is the point
# — and the rest in LuuvCRM Settings in the database. site_config.example.json
# IS committed: it is the documentation of what to put there.
site_config.json
*.local.json

# One-off debug / data-fix scratch scripts. The 11 that were here are deleted;
# these patterns stay so the next one does not get committed by accident. A
# script worth keeping belongs in a bench command or a patch, not in the package.
luuvcrm/check_*.py
luuvcrm/debug_*.py
luuvcrm/fix_*.py

# Generated knowledge-graph cache (the /graphify skill's output)
graphify-out/
